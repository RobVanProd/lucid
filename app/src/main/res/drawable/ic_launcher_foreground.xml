<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- LUCID Icon - A single dot representing focus and intention -->
    <!-- The dot is centered, representing the pulsing cursor -->

    <group android:translateX="54" android:translateY="54">
        <!-- Outer subtle ring - awareness -->
        <path
            android:pathData="M0,-20 A20,20 0 1,1 0,20 A20,20 0 1,1 0,-20"
            android:strokeWidth="1"
            android:strokeColor="#E0E0E0"
            android:fillColor="@android:color/transparent"/>

        <!-- Inner dot - focus -->
        <path
            android:pathData="M0,-8 A8,8 0 1,1 0,8 A8,8 0 1,1 0,-8"
            android:fillColor="#1A1A1A"/>
    </group>
</vector>
